<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.internship.mapper.InternshipAppraisalMapper">
    <resultMap id="SubmissionMap" type="com.internship.entity.InternshipAppraisalSubmission">
        <id property="id" column="id"/>
        <result property="studentId" column="student_id"/>
        <result property="status" column="status"/>
        <result property="submittedAt" column="submitted_at"/>
        <result property="reviewedAt" column="reviewed_at"/>
        <result property="reviewerId" column="reviewer_id"/>
        <result property="reviewComment" column="review_comment"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <resultMap id="AppraisalFileMap" type="com.internship.entity.InternshipAppraisalFile">
        <id property="id" column="id"/>
        <result property="submissionId" column="submission_id"/>
        <result property="stageAssignmentId" column="stage_assignment_id"/>
        <result property="companyId" column="company_id"/>
        <result property="companyName" column="company_name"/>
        <result property="fileUploadId" column="file_upload_id"/>
        <result property="fileName" column="file_name"/>
        <result property="filePath" column="file_path"/>
        <result property="fileSize" column="file_size"/>
        <result property="fileType" column="file_type"/>
        <result property="uploadTime" column="upload_time"/>
    </resultMap>

    <select id="findSubmissionByStudentId" resultMap="SubmissionMap">
        select * from internship_appraisal_submission
        where student_id = #{studentId} order by id desc limit 1
    </select>

    <select id="findSubmissionByStudentIdForUpdate" resultMap="SubmissionMap">
        select * from internship_appraisal_submission
        where student_id = #{studentId} order by id desc limit 1
        for update
    </select>

    <select id="findSubmissionById" resultMap="SubmissionMap">
        select * from internship_appraisal_submission where id = #{id}
    </select>

    <select id="findFilesBySubmissionId" resultMap="AppraisalFileMap">
        select * from internship_appraisal_file
        where submission_id = #{submissionId} order by id asc
    </select>

    <select id="findFileById" resultMap="AppraisalFileMap">
        select * from internship_appraisal_file where id = #{id}
    </select>

    <insert id="insertSubmission" parameterType="com.internship.entity.InternshipAppraisalSubmission"
            useGeneratedKeys="true" keyProperty="id">
        insert into internship_appraisal_submission (
            student_id, status, submitted_at, reviewed_at, reviewer_id,
            review_comment, create_time, update_time
        ) values (
            #{studentId}, #{status}, #{submittedAt}, #{reviewedAt}, #{reviewerId},
            #{reviewComment}, now(), now()
        )
    </insert>

    <update id="updateSubmission" parameterType="com.internship.entity.InternshipAppraisalSubmission">
        update internship_appraisal_submission
        <set>
            <if test="status != null">status = #{status},</if>
            <if test="submittedAt != null">submitted_at = #{submittedAt},</if>
            <if test="reviewedAt != null">reviewed_at = #{reviewedAt},</if>
            <if test="reviewerId != null">reviewer_id = #{reviewerId},</if>
            <if test="reviewComment != null">review_comment = #{reviewComment},</if>
            update_time = now()
        </set>
        where id = #{id} and student_id = #{studentId}
    </update>

    <insert id="insertFile" parameterType="com.internship.entity.InternshipAppraisalFile"
            useGeneratedKeys="true" keyProperty="id">
        insert into internship_appraisal_file (
            submission_id, stage_assignment_id, company_id, company_name,
            file_upload_id, file_name, file_path, file_size, file_type, upload_time
        ) values (
            #{submissionId}, #{stageAssignmentId}, #{companyId}, #{companyName},
            #{fileUploadId}, #{fileName}, #{filePath}, #{fileSize}, #{fileType}, now()
        )
    </insert>

    <delete id="deleteFile">
        delete from internship_appraisal_file where id = #{id}
    </delete>
</mapper>

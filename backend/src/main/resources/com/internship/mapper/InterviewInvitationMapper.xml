<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.internship.mapper.InterviewInvitationMapper">

    <resultMap id="BaseResultMap" type="com.internship.entity.InterviewInvitation">
        <id column="id" property="id"/>
        <result column="student_id" property="studentId"/>
        <result column="company_id" property="companyId"/>
        <result column="position_id" property="positionId"/>
        <result column="position_name" property="positionName"/>
        <result column="company_name" property="companyName"/>
        <result column="interview_time" property="interviewTime"/>
        <result column="interview_location" property="interviewLocation"/>
        <result column="interview_type" property="interviewMethod"/>
        <result column="status" property="status"/>
        <result column="reject_reason" property="rejectReason"/>
        <result column="remark" property="remark"/>
        <result column="resolved_contact_person" property="contactPerson"/>
        <result column="resolved_contact_phone" property="contactPhone"/>
        <result column="resolved_contact_email" property="contactEmail"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="website" property="website"/>
        <result column="company_address" property="companyAddress"/>
    </resultMap>

    <sql id="InvitationColumns">
        ii.*, cu.website,
        <include refid="com.internship.mapper.PositionMapper.ContactPerson"/> AS resolved_contact_person,
        <include refid="com.internship.mapper.PositionMapper.ContactPhone"/> AS resolved_contact_phone,
        <include refid="com.internship.mapper.PositionMapper.ContactEmail"/> AS resolved_contact_email,
        CONCAT(COALESCE(p.province,''), COALESCE(p.city,''), COALESCE(p.district,''), COALESCE(p.detail_address,'')) AS company_address
    </sql>
    <sql id="InvitationJoins">
        FROM interview_invitation ii
        LEFT JOIN company_users cu ON ii.company_id = cu.id
        LEFT JOIN position p ON ii.position_id = p.id AND p.company_id = ii.company_id
        LEFT JOIN company_contact cc ON p.contact_id = cc.id AND cc.company_id = p.company_id
    </sql>
    <select id="findByStudentAndPosition" resultMap="BaseResultMap">
        SELECT <include refid="InvitationColumns"/> <include refid="InvitationJoins"/>
        WHERE ii.student_id = #{studentId} AND ii.position_id = #{positionId}
        ORDER BY COALESCE(ii.update_time, ii.create_time) DESC, ii.id DESC LIMIT 1
    </select>
    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="InvitationColumns"/> <include refid="InvitationJoins"/>
        WHERE ii.id = #{id}
    </select>

    <!-- Keep the same latest-record ordering as findByStudentAndPosition, without loading history. -->
    <select id="findLatestForStudentPositions" resultMap="BaseResultMap">
        SELECT requested.student_id, requested.position_id, ii.interview_type
        FROM (
            <foreach collection="pairs" item="pair" separator=" UNION ALL ">
                SELECT #{pair.studentId} AS student_id, #{pair.positionId} AS position_id
            </foreach>
        ) requested
        LEFT JOIN interview_invitation ii ON ii.id = (
            SELECT latest.id
            FROM interview_invitation latest
            WHERE latest.student_id = requested.student_id
              AND latest.position_id = requested.position_id
            ORDER BY COALESCE(latest.update_time, latest.create_time) DESC, latest.id DESC
            LIMIT 1
        )
    </select>

    <select id="findByStudentId" resultMap="BaseResultMap">
        SELECT <include refid="InvitationColumns"/> <include refid="InvitationJoins"/>
        WHERE ii.student_id = #{studentId}
        ORDER BY ii.interview_time DESC
    </select>

    <select id="findByStudentIdAndStatus" resultMap="BaseResultMap">
        SELECT <include refid="InvitationColumns"/> <include refid="InvitationJoins"/>
        WHERE ii.student_id = #{studentId} AND ii.status = #{status}
        ORDER BY ii.interview_time DESC
    </select>

</mapper>

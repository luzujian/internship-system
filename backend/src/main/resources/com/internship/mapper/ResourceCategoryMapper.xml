<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.internship.mapper.ResourceCategoryMapper">

    <insert id="insert" parameterType="com.internship.entity.ResourceCategory"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO resource_categories (name, parent_id)
        VALUES (#{name}, #{parentId})
    </insert>

    <delete id="deleteById">
        DELETE FROM resource_categories WHERE id = #{id}
    </delete>

    <update id="updateById" parameterType="com.internship.entity.ResourceCategory">
        UPDATE resource_categories
        SET name = #{name}, parent_id = #{parentId}
        WHERE id = #{id}
    </update>

    <select id="selectById" resultType="com.internship.entity.ResourceCategory">
        SELECT * FROM resource_categories WHERE id = #{id}
    </select>

    <select id="selectList" resultType="com.internship.entity.ResourceCategory">
        SELECT * FROM resource_categories ORDER BY id
    </select>

    <select id="selectByParentId" resultType="com.internship.entity.ResourceCategory">
        SELECT * FROM resource_categories WHERE parent_id = #{parentId} ORDER BY id
    </select>
    
    <select id="selectTopCategories" resultType="com.internship.entity.ResourceCategory">
        SELECT * FROM resource_categories WHERE parent_id IS NULL ORDER BY id
    </select>
</mapper>
